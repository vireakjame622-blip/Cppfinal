{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build main.cpp",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++17", "-Wall", "-g", "main.cpp", "-o", "library"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
